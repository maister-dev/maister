{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "MAIster",
  "description": "Public documentation for governed AI software delivery",
  "colors": {
    "primary": "#588157",
    "light": "#96b795",
    "dark": "#466645"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#ffffff",
      "dark": "#0a0f0d"
    }
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 650
    }
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/assets/favicon.png",
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg",
    "href": "/"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/maister-dev/maister"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "mcp", "cursor", "vscode"]
  },
  "seo": {
    "indexing": "all"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "Start here",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Product tour",
            "pages": [
              "product-tour/application-map",
              "product-tour/project-workspace",
              "product-tour/project-repository-and-packages",
              "product-tour/tasks-and-runs",
              "product-tour/run-history-and-workbench"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/delivery-spine",
              "concepts/path-to-agentization",
              "concepts/flows-and-runs",
              "concepts/tasks-runs-and-evaluations",
              "concepts/recursive-agent-harness",
              "concepts/evidence-and-review",
              "concepts/project-brain-and-agents"
            ]
          },
          {
            "group": "Administration",
            "pages": [
              "administration/runners-and-models",
              "administration/users-tokens-and-access",
              "administration/mcp-and-secrets",
              "administration/scheduler-and-platform-agents",
              "administration/project-platform-agents",
              "administration/scheduler-and-automations"
            ]
          },
          {
            "group": "Flow Studio",
            "pages": [
              "studio/flow-studio-and-packages",
              "studio/ai-assistant",
              "studio/node-types",
              "studio/structured-results-and-context"
            ]
          },
          {
            "group": "Evaluation",
            "pages": ["evaluation/run-comparison"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/register-a-project",
              "guides/package-sources-and-versions",
              "guides/human-in-the-loop",
              "guides/review-and-promote",
              "guides/review-rework-and-takeover",
              "guides/studio-and-evaluation"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/project-manifest",
              "reference/flow-manifest",
              "reference/agent-runtimes"
            ]
          },
          {
            "group": "Operate",
            "pages": [
              "operations/deployment",
              "operations/execution-hosts",
              "operations/costs-and-budgets",
              "operations/troubleshooting"
            ]
          }
        ]
