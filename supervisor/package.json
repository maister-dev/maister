{
  "name": "@maister/supervisor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25 || >=26.13.0 <27"
  },
  "scripts": {
    "test:integration:ab": "node ../scripts/run-stage-ab-tests.mjs supervisor",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --import tsx --env-file-if-exists=.env src/main.ts",
    "smoke:acp": "tsx scripts/smoke-acp-adapter.ts",
    "lint": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "node ../scripts/run-supervisor-integration.mjs",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.95.0",
    "@agentclientprotocol/codex-acp": "2.2.2",
    "@agentclientprotocol/sdk": "2.0.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-plugin-import-x": "4.18.1"
  }
}
