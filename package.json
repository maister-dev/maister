{
  "name": "maister",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @maister/supervisor --filter maister-web dev",
    "local:blast-maister-state": "node scripts/blast-maister-local-state.mjs",
    "test:local-reset": "node --test scripts/blast-maister-local-state.test.mjs",
    "validate:docs": "node scripts/validate-docs-mermaid.mjs && node scripts/validate-docs-adr-anchors.mjs && node scripts/validate-docs-links.mjs && node scripts/validate-docs-indexes.mjs && pnpm --filter maister-web db:erd --check",
    "validate:contracts": "node scripts/validate-contracts.mjs && pnpm validate:adapter-mirrors",
    "validate:adapter-mirrors": "node scripts/validate-adapter-mirrors.ts",
    "validate:docs:all": "node scripts/validate-docs-mermaid.mjs --all && node scripts/validate-docs-adr-anchors.mjs --all && node scripts/validate-docs-links.mjs --all && node scripts/validate-docs-indexes.mjs && pnpm --filter maister-web db:erd --check",
    "validate:docs:adr": "node scripts/validate-docs-adr-anchors.mjs",
    "validate:docs:adr:all": "node scripts/validate-docs-adr-anchors.mjs --all",
    "validate:docs:links": "node scripts/validate-docs-links.mjs",
    "validate:docs:links:all": "node scripts/validate-docs-links.mjs --all",
    "verify:m38": "node scripts/verify-m38-surface.mjs",
    "site:dev": "pnpm --filter @maister/site dev",
    "site:build": "pnpm --filter @maister/site build",
    "site-docs:dev": "pnpm --filter @maister/site-docs dev",
    "site-docs:validate": "pnpm --filter @maister/site-docs validate"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "mermaid": "^11.4.1",
    "yaml": "^2.9.0"
  }
}
