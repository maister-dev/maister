{
  "knowledge_search": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "owner": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "company"
              },
              "companyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
              }
            },
            "required": [
              "kind",
              "companyId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "project"
              },
              "projectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
              }
            },
            "required": [
              "kind",
              "projectId"
            ],
            "additionalProperties": false
          }
        ]
      },
      "q": {
        "default": "",
        "type": "string",
        "minLength": 0,
        "maxLength": 2000,
        "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "assertion",
          "observation",
          "decision",
          "procedure",
          "lesson",
          "state_fact",
          "direction"
        ]
      },
      "confirmation": {
        "type": "string",
        "enum": [
          "unconfirmed",
          "confirmed",
          "revoked"
        ]
      },
      "conflict": {
        "type": "string",
        "enum": [
          "unresolved",
          "resolved"
        ]
      },
      "freshness": {
        "type": "string",
        "enum": [
          "current",
          "stale",
          "unknown"
        ]
      },
      "limit": {
        "default": 20,
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "additionalProperties": false
  },
  "knowledge_get": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "recordId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
      },
      "revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    },
    "required": [
      "recordId"
    ],
    "additionalProperties": false
  },
  "knowledge_evidence": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "recordId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
      },
      "revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "limit": {
        "default": 20,
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "required": [
      "recordId"
    ],
    "additionalProperties": false
  },
  "knowledge_conflicts": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "recordId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
      },
      "revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "limit": {
        "default": 20,
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "required": [
      "recordId"
    ],
    "additionalProperties": false
  },
  "knowledge_capture_source": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "owner": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "company"
              },
              "companyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
              }
            },
            "required": [
              "kind",
              "companyId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "project"
              },
              "projectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
              }
            },
            "required": [
              "kind",
              "projectId"
            ],
            "additionalProperties": false
          }
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
      },
      "content": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32000,
        "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
      },
      "reportedSourceVersion": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
      },
      "idempotencyKey": {
        "type": "string",
        "minLength": 8,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    "required": [
      "owner",
      "title",
      "content",
      "idempotencyKey"
    ],
    "additionalProperties": false
  }
}
