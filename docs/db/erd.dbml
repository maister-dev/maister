  indexes {
    (delivery_id, attempt_no) [name: 'webhook_delivery_attempts_delivery_attempt_uq', unique]
    delivery_id [name: 'webhook_delivery_attempts_delivery_idx']
  }
}

table webhook_events {
  id text [pk, not null]
