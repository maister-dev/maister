# Files are provisioned by the target operator and readable by the helper account.
MAISTER_STAND_TARGET_CONFIG_FILE=/etc/maister/stand-target.json
MAISTER_STAND_HOST=127.0.0.1
MAISTER_STAND_PORT=7443
MAISTER_STAND_JOURNAL_PAGES=65536
MAISTER_STAND_SYSTEMCTL=/usr/bin/systemctl
MAISTER_STAND_JOURNALCTL=/usr/bin/journalctl
MAISTER_STAND_TLS_CERT_FILE=/etc/maister/tls/helper.pem
MAISTER_STAND_TLS_KEY_FILE=/etc/maister/tls/helper-key.pem
MAISTER_STAND_PLATFORM_CA_FILE=/etc/maister/tls/platform-client-ca.pem
MAISTER_STAND_PLATFORM_CERT_SHA256=
MAISTER_STAND_PLATFORM_CREDENTIAL_FILE=/etc/maister/credentials/platform-token
MAISTER_STAND_HELPER_CREDENTIAL_FILE=/etc/maister/credentials/helper-token
MAISTER_STAND_AUTHORITY_ORIGIN=https://authority.example.invalid:7444
MAISTER_STAND_AUTHORITY_SERVER_NAME=authority.example.invalid
MAISTER_STAND_AUTHORITY_CA_FILE=/etc/maister/tls/authority-ca.pem
