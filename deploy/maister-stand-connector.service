[Unit]
Description=MAIster configured stand helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maister-stand
Group=maister-stand
WorkingDirectory=/opt/maister/stand-connector
EnvironmentFile=/etc/maister/stand-connector.env
Environment=MAISTER_STAND_STATE_DIRECTORY=/var/lib/maister-stand
StateDirectory=maister-stand
StateDirectoryMode=0700
ExecStart=/usr/bin/node src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
