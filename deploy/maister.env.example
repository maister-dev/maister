# MAIster systemd EnvironmentFile for maister-web.service.
# Copy to /etc/maister/maister.env, then: chown maister:maister && chmod 600.
# The supervisor unit reads its OWN file (supervisor/.env, from
# supervisor/.env.sample) — not this one.
# Full variable reference: docs/configuration.md.

NODE_ENV=production
LOG_LEVEL=info

# Shared check slots for Flow CLI/check commands. Use the same setting in
# supervisor/.env for ACP commands on this host.
# MAISTER_MAX_CONCURRENT_HEAVY_CHECKS=1
# MAISTER_BUILD_PROFILE=cold

# Repo checkout dir. Supervisor AND web resolve `.maister/` from here, so both
# units MUST use this same path (co-located shared filesystem — see ADR-023).
MAISTER_RUNTIME_ROOT=/opt/maister

# Repo + worktree roots (optional; ADR-025). Default to the maister user's home
# (~/.maister/repos, ~/.maister/worktrees). Set these to place clones and run
# worktrees on a specific volume. MAISTER_WORKTREE_ROOT (singular) is a
# deprecated fallback for MAISTER_WORKTREES_ROOT.
# MAISTER_REPOS_ROOT=/opt/maister/repos
# MAISTER_WORKTREES_ROOT=/opt/maister/worktrees
# (ADR-166) If you set MAISTER_WORKTREES_ROOT (or MAISTER_LOCAL_PACKAGES_ROOT)
# here, mirror the same path into MAISTER_WORKSPACE_ROOTS in supervisor/.env —
# the supervisor adopts a run worktree only under its configured roots. The
# supervisor's own state dir (MAISTER_EXECUTION_HOST_STATE_DIR, default
# /opt/maister/.maister/execution-host/) and identity pin live in
# supervisor/.env too (template: supervisor/.env.sample).

# (S3.7) Host runtime limits — read by the SUPERVISOR only (canonical template:
# supervisor/.env.sample); mirrored here, commented with the defaults, so every
# operator surface shows the same bounded-storage contract. Low < soft < hard;
# invalid coupled limits refuse supervisor boot. Contract: docs/configuration.md.
# MAISTER_EVENT_OUTBOX_LOW_BYTES=335544320
# MAISTER_EVENT_OUTBOX_SOFT_BYTES=419430400
# MAISTER_EVENT_OUTBOX_HARD_BYTES=536870912
# MAISTER_EVENT_OUTBOX_LOW_ROWS=64000
# MAISTER_EVENT_OUTBOX_SOFT_ROWS=80000
# MAISTER_EVENT_OUTBOX_HARD_ROWS=100000
# MAISTER_EVENT_OUTBOX_CONTROL_BYTES=16777216
# MAISTER_EVENT_OUTBOX_CONTROL_ROWS=1024
# MAISTER_EVENT_ACK_GRACE_MS=86400000
# MAISTER_EXECUTION_HOST_STATE_MAX_BYTES=2147483648
# MAISTER_RUNTIME_OBJECT_LOW_BYTES=6442450944
# MAISTER_RUNTIME_OBJECT_SOFT_BYTES=8589934592
# MAISTER_RUNTIME_OBJECT_MAX_BYTES=10737418240
# MAISTER_RUNTIME_MIN_FREE_BYTES=1073741824

# --- Database: Postgres in Docker, published on loopback (see compose.yml) ---
DB_URL=postgres://maister:maister@localhost:5432/maister
# Optional. Postgres pool ceiling per web process. Default 25
# (with connectionTimeoutMillis=10000 and idleTimeoutMillis=30000).
# MAISTER_DB_POOL_MAX=25
POSTGRES_USER=maister
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maister

# --- Web <-> supervisor: loopback by default. Keep the endpoint private. ---
# Restrict other hosts to an operator-controlled private network and allow only Web.
# The host key is a routing check. Firewall the supervisor port from public access.
MAISTER_SUPERVISOR_URL=http://localhost:7777
# Optional stable host key from GET /health, verified before addressed dispatch.
# MAISTER_SELECTED_EXECUTION_HOST_KEY=
# Optional JSON list of project IDs approved for addressed launch in the pilot.
# MAISTER_SELECTED_EXECUTION_HOST_PROJECT_IDS=["project-id"]
# Enable after upgrading all Web writers and draining older registrars.
# MAISTER_ADDITIONAL_EXECUTION_HOSTS=[{"url":"http://127.0.0.1:7778","hostKey":"eh_peer_key","displayName":"Build host B","projectIds":["project-id"]}]
MAISTER_SUPERVISOR_PORT=7777

# Optional Web-only mutual TLS listener. Bind a dedicated private address for a remote stand.
# MAISTER_STAND_AUTHORITY_HOST=127.0.0.1
# MAISTER_STAND_AUTHORITY_PORT=7444
# MAISTER_STAND_AUTHORITY_CA_FILE=/etc/maister/tls/stand-helper-ca.pem
# MAISTER_STAND_AUTHORITY_CERT_FILE=/etc/maister/tls/stand-authority.pem
# MAISTER_STAND_AUTHORITY_KEY_FILE=/etc/maister/tls/stand-authority-key.pem
# Populate a target-specific Web-only credential named by that target's helperCredentialEnv.
# MAISTER_STAND_PILOT_HELPER_TOKEN=

# --- Auth.js (web). Generate the secret with: openssl rand -base64 32 ---
AUTH_SECRET=
AUTH_URL=https://maister.example.com

# Optional GitHub pull request API credential for the web service.
# Git push still uses the repository's Git transport credentials.
# GH_TOKEN=

# --- Optional provider env overrides.
#     ACP tools are configured in their own CLIs by default. The supervisor
#     passes process env to spawned agents, so set keys here only when you
#     intentionally want MAIster to supply provider env or model discovery. ---
ANTHROPIC_API_KEY=
# Optional Anthropic-compatible provider (z.ai GLM, OpenRouter, ...):
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=
# Optional model discovery / explicit codex provider env:
# OPENAI_API_KEY=

# --- Concurrency + keep-alive (defaults; see docs/configuration.md) ---
MAISTER_MAX_CONCURRENT_RUNS=3
# Web-only vault limits (ADR-210).
# MAISTER_AGENT_MEMORY_MAX_CHARS=32768
# MAISTER_AGENT_MEMORY_NOTE_MAX_CHARS=65536
# MAISTER_AGENT_MEMORY_INDEX_MAX_CHARS=8192
# MAISTER_AGENT_MEMORY_VAULT_MAX_CHARS=1048576
# MAISTER_AGENT_MEMORY_MAX_NOTES=256
# MAISTER_AGENT_MEMORY_MAX_PENDING=256
# Web-only since ADR-180; the supervisor keeps the absolute cap below instead.
MAISTER_KEEPALIVE_MINUTES=30
# Supervisor-only absolute cap on one pending permission (hours, ADR-180).
MAISTER_PERMISSION_MAX_HOURS=24
# ADR-161: per-run cap on operator-initiated node restarts (see docs/configuration.md).
MAISTER_MAX_OPERATOR_RESTARTS=10

# --- Scheduler clock (web tier) ---
# Supported single-box systemd install: the web process owns the 60s fallback
# timer. For multi-web/external-cron operation set this to false, set a nonempty
# MAISTER_CRON_TOKEN, and invoke GET/POST /api/cron/tick every minute.
MAISTER_SCHEDULER_TIMER_ENABLED=true
MAISTER_SCHEDULER_TICK_INTERVAL_SECONDS=60
# Maximum total Flow wait lifetime, including extensions (default: seven days).
# MAISTER_MAX_WAIT_SECONDS=604800
# MAISTER_CRON_TOKEN=replace-with-a-random-server-only-secret
# Sustained event-plane lag warning age; does not change stall/lost semantics.
MAISTER_EVENT_STREAM_LAG_SECONDS=120

# --- Outbound webhooks (ADR-076; web tier only — defaults; see docs/configuration.md) ---
# Max deliveries/events claimed per webhook_delivery drain tick.
MAISTER_WEBHOOK_DELIVERY_BATCH=20
# Per-attempt HTTP timeout (ms) for the drain path and the test-ping route.
MAISTER_WEBHOOK_TIMEOUT_MS=10000
# Terminal-dead threshold: a delivery hitting this attempt_count becomes `dead`.
MAISTER_WEBHOOK_MAX_ATTEMPTS=8
# Destination egress-policy allowlist: comma-separated EXACT hosts exempt from
# the SSRF block (loopback/private/link-local/metadata/multicast/unspecified),
# e.g. a local consumer. Unset = no exemptions.
# MAISTER_WEBHOOK_ALLOW_HOSTS=127.0.0.1

# A/B canonical projection worker (web only). Bounds are validated before DB boot.
# Concurrency 1..2; rows 1..100; bytes 1..1048576; lease 30000..60000 ms.
# One legal maximum event is allowed even when it exceeds the byte quantum.
MAISTER_PROJECTION_CONCURRENCY=2
MAISTER_PROJECTION_BATCH_ROWS=100
MAISTER_PROJECTION_BATCH_BYTES=1048576
MAISTER_PROJECTION_LEASE_MS=30000
# Runtime events per ingest transaction and per host ACK (web only; ADR-167
# amendment 2026-09-25). Range 1..1000; invalid or empty refuses boot (CONFIG).
# The reader buffers at most 4x this many rows before pausing the host stream.
# MAISTER_EVENT_INGEST_BATCH_ROWS=200
# Event/file/storage limits belong in supervisor/.env (see its .env.sample).

# Personal librarian retention (web tier). Positive integers; memory items remain until forgotten.
MAISTER_LIBRARIAN_HISTORY_RETENTION_DAYS=365
MAISTER_LIBRARIAN_SNAPSHOT_RETENTION_DAYS=30

# Optional per-check workspace integrity limits for the web service.
# A global administrator's saved override takes precedence.
# MAISTER_WORKSPACE_INTEGRITY_MAX_SIZE_MIB=1024
# MAISTER_WORKSPACE_INTEGRITY_MAX_DURATION_SECONDS=120
# MAISTER_WORKSPACE_INTEGRITY_MAX_ENTRIES=100000

# Studio catalog source allowlist (web process). Omitting uses Anthropic and Vercel.
# MAISTER_STUDIO_CATALOG_REPOS='[{"id":"anthropic-skills","repo":"anthropics/skills","kind":"skill"},{"id":"company-mcp","repo":"example/approved-mcp","kind":"mcp"}]'


# Optional assignment routing. Map durable supervisor host keys to HTTPS origins
# or operator-authenticated loopback tunnels. New placements choose the preferred
# key. Existing assignments and checkpoint resumes keep their original identity.
# MAISTER_EXECUTION_HOST_ENDPOINTS={"eh_design_b":"http://127.0.0.1:7778","eh_design_c":"http://127.0.0.1:7779"}
# HTTPS routes require a private ingress that validates the web client certificate.
# MAISTER_EXECUTION_HOST_TLS_CA_FILE=/etc/maister/tls/host-ca.pem
# MAISTER_EXECUTION_HOST_TLS_CERT_FILE=/etc/maister/tls/web.pem
# MAISTER_EXECUTION_HOST_TLS_KEY_FILE=/etc/maister/tls/web.key
# MAISTER_EXECUTION_HOST_PREFERRED_KEY=eh_design_b
