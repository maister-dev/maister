{
  "name": "maister-web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "pnpm clean && next dev",
    "clean": "node scripts/clean-next-artifacts.mjs",
    "build": "pnpm clean && next build",
    "start": "node --import tsx server.ts",
    "lint": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:integration:ab": "node ../scripts/run-stage-ab-tests.mjs web",
    "test:integration:isolation": "node ../scripts/run-stage-ab-tests.mjs isolation",
    "test:watch": "vitest --project unit",
    "test:e2e": "tsx e2e/run.ts",
    "test:e2e:live": "tsx e2e/run.ts --config playwright.live.config.ts",
    "test:e2e:execution-ab": "tsx e2e/run.ts --config playwright.execution-ab.config.ts",
    "test:e2e:librarian": "tsx e2e/run.ts --config playwright.librarian.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --import ./scripts/_register-shim.mjs lib/db/migrate.ts",
    "db:migrate:brain": "tsx lib/db/migrate-brain.ts",
    "db:check": "tsx --import ./scripts/_register-shim.mjs lib/db/check.ts",
    "execution:projection:rearm": "tsx --import ./scripts/_register-shim.mjs scripts/rearm-execution-projection.ts",
    "db:seed": "tsx --import ./scripts/_register-shim.mjs lib/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:erd": "tsx --import ./scripts/_register-shim.mjs scripts/generate-erd-dbml.ts",
    "execution-data-plane:import-legacy": "tsx --import ./scripts/_register-shim.mjs scripts/import-legacy-execution-data-plane.ts",
    "install-flow": "tsx --import ./scripts/_register-shim.mjs scripts/install-flow.ts",
    "install-package": "tsx --import ./scripts/_register-shim.mjs scripts/install-package.ts",
    "run-flow": "tsx --import ./scripts/_register-shim.mjs scripts/run-flow.ts",
    "backfill-flow-revisions": "tsx --import ./scripts/_register-shim.mjs scripts/backfill-flow-revisions.ts",
    "generate:qualification-schema": "tsx scripts/generate-task-qualification-json.ts",
    "validate:qualification-schema": "tsx scripts/generate-task-qualification-json.ts --check",
    "validate-authored-flow": "tsx --import ./scripts/_register-shim.mjs scripts/validate-authored-flow.ts",
    "validate:package-compatibility": "tsx --import ./scripts/_register-shim.mjs scripts/validate-package-compatibility.ts",
    "import-flow-package-draft": "tsx --import ./scripts/_register-shim.mjs scripts/import-flow-package-draft.ts",
    "export-authored-flow": "tsx --import ./scripts/_register-shim.mjs scripts/export-authored-flow.ts",
    "install-authored-flow-package": "tsx --import ./scripts/_register-shim.mjs scripts/install-authored-flow-package.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
