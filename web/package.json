    "@git-diff-view/react": "0.1.8",
    "@heroicons/react": "2.2.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@js-temporal/polyfill": "0.5.1",
    "@lezer/highlight": "1.2.5",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@uiw/codemirror-themes": "4.25.12",
    "@uiw/react-codemirror": "4.25.12",
    "@xyflow/react": "12.12.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "intl-messageformat": "12.1.4",
    "mustache": "^4.2.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "pg": "^8.23.1",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "shiki": "4.5.0",
    "tar": "^7.5.22",
    "undici": "8.12.3",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dbml/core": "11.0.0",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/mustache": "^4.2.6",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/ui": "^5.0.5",
    "dotenv": "^18.0.9",
    "drizzle-dbml-generator": "0.10.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "pino-pretty": "^13.2.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
