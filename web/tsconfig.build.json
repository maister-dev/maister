{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next/cache/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "e2e",
    "test-support",
    "scripts",
    "vitest.*.ts",
    "playwright*.ts",
    ".next/dev"
  ]
}
